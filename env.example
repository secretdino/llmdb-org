# ==============================================================================
# LLMDB ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE (env.example)
# ==============================================================================
# Copy this file to '.env.local' in the root directory for local development.
# WARNING: Never commit '.env.local' or any other active secrets file to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL.
# In local development, defaults to the postgres container: postgresql://postgres:postgres@localhost:5432/llmdb
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/llmdb"

# Database Driver Mode.
# Options: 'neon' (serverless Neon driver) or 'pg' (standard Node-postgres Pool).
# In production, defaults to 'neon'. In development, defaults to 'pg'.
DB_DRIVER="pg"

# ------------------------------------------------------------------------------
# 2. NextAuth.js Authentication
# ------------------------------------------------------------------------------
# Secret key used for signing and encrypting NextAuth JWT session cookies.
# Set this to a 32-character random string (e.g. generate via: openssl rand -base64 32)
NEXTAUTH_SECRET="your-32-character-random-secret-key"

# The canonical base URL of your application. Used for authentication redirect flows.
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. GitHub OAuth credentials
# ------------------------------------------------------------------------------
# Required for user profile authorization and login page integrations.
# Acquire these by creating a new OAuth App in GitHub Developer Settings.
GITHUB_ID="mock_github_client_id"
GITHUB_SECRET="mock_github_client_secret"

# ------------------------------------------------------------------------------
# 4. Security & Cryptographic Salts
# ------------------------------------------------------------------------------
# High-entropy cryptographic salt used to salt/hash crawler API keys at rest.
# Must be set to a secure key in production.
API_KEY_SALT="secure-crypto-salt-key-change-me"

# ------------------------------------------------------------------------------
# 5. Database Seed Settings
# ------------------------------------------------------------------------------
# Password assigned to the system administrator account (admin@llmdb.org) during
# the database seed process (npm run db:seed).
# REQUIRED in production environments to avoid deploying weak defaults.
ADMIN_SEED_PASSWORD="adminpass"
